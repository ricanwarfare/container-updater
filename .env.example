# Ready-to-run configuration for the usual "$HOME/docker/<stack>" layout.
# Copy this file to .env. Change only BASE_DIR if your Compose stacks live elsewhere.
# This is trusted Bash configuration; keep the resulting .env private.
BASE_DIR="$HOME/docker"
# Leave empty to update every Compose stack under BASE_DIR.
EXCLUDE_DIRS=""
DRY_RUN=false
VERBOSE=true
# Keep host-wide image cleanup opt-in. Set true only when it suits this host.
PRUNE_IMAGES=false
# Disabled until containers explicitly opt in with container-updater.autostart=true.
AUTOSTART=false
AUTOSTART_RETRY_DELAY=10
PULL_RETRIES=3
PULL_RETRY_DELAY=5
WAIT_TIMEOUT=300
# Hard cap on a single stack's pull/recreate+health-wait. Without this a Docker
# call that wedges on the socket hangs the whole run (and its lock) indefinitely.
# Set this below your scheduler's interval. 0 disables the cap. Needs `timeout`.
STACK_TIMEOUT=1800
# When a competing run holds the lock, log the lock's age once it exceeds this
# many seconds, so a wedged previous run stops being a silent skip. 0 disables.
LOCK_STALE_SECONDS=3600
RUN_HOOKS=true
LOG_MAX_SIZE_KB=5120
# Self-updating from GitHub releases (opt-in).
SELF_UPDATE=false
# GitHub repository to track for releases.
GITHUB_REPO="ricanwarfare/container-updater"
# Defaults place logs and locks under BASE_DIR/container-updater.
# LOG_FILE="/absolute/path/to/updater.log"
# LOCK_FILE="/absolute/path/to/updater.lock"
# NOTIFY_FAILURE_WEBHOOK="https://your-generic-webhook-endpoint"

# NOTIFY_SUCCESS_WEBHOOK="https://your-summary-webhook-endpoint"

