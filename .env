# ==========================================
# Auto Docker Updater - Configuration File
#
# Instructions:
# Create a file named '.env' in the same folder as updater.sh.
# Adjust the paths below to match your specific server environment.
# ==========================================

# The master directory where all your separate container folders are located.
# The script will automatically scan all subdirectories here.
BASE_DIR="${BASE_DIR:-$HOME/docker}"

# Where to save the update logs
LOG_FILE="${LOG_FILE:-$HOME/docker/container-updater/updater.log}"

# Directories to exclude from scanning (colon-separated folder names)
# Example: EXCLUDE_DIRS=container-updater:backups:testing
# EXCLUDE_DIRS="${EXCLUDE_DIRS:-}"

# Override the path to the docker binary (optional)
# By default, the script will automatically detect the 'docker' command.
# DOCKER_BIN="${DOCKER_BIN:-}"

# Enable dry-run mode to test without making changes (set to "true" to enable)
# DRY_RUN="${DRY_RUN:-false}"

# Print log messages to console in addition to the log file
# VERBOSE="${VERBOSE:-false}"

# Automatically prune unused Docker images after updating (set to "false" to disable)
# PRUNE_IMAGES="${PRUNE_IMAGES:-true}"

# Webhook URL to notify on container update failures (optional)
# NOTIFY_FAILURE_WEBHOOK="${NOTIFY_FAILURE_WEBHOOK:-}"

# Path to the lock file (prevents overlapping cron runs)
# LOCK_FILE="${LOCK_FILE:-}"
